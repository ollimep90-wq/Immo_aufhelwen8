# Domain eintragen, z. B. beratung.example.de – Caddy holt das Zertifikat selbst.
DOMAIN.EINTRAGEN {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	log {
		# keine Zugriffsprotokolle mit IP-Adressen auf Dauer: nur Fehler
		level ERROR
	}
	reverse_proxy app:8000
}
